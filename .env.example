# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Hosted providers (Neon, Supabase, RDS) get TLS automatically; you do not
# need to append ?sslmode=require, though it is harmless.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/shared_album

# ---------------------------------------------------------------------------
# Cloudinary — https://console.cloudinary.com/settings/api-keys
# CLOUDINARY_API_SECRET must NEVER be exposed to the browser.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# Root folder for all album assets inside your Cloudinary account.
CLOUDINARY_FOLDER=shared-albums

# ---------------------------------------------------------------------------
# Sessions / crypto
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every session AND makes existing album codes
# unreadable (they are encrypted at rest with a key derived from it).
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Upload limits (megabytes). Raise/lower to match your Cloudinary plan.
# ---------------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=100
MAX_VIDEO_SIZE_MB=2000

# ---------------------------------------------------------------------------
# Server
# macOS note: port 5000 is taken by AirPlay Receiver, hence 3000.
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public origin of the deployed app. Used for share links / QR codes and for
# CSRF origin checks in production. Comma-separate to allow several origins.
PUBLIC_ORIGIN=http://localhost:3000

# Directory used to stage generated ZIP archives before download.
DOWNLOAD_TMP_DIR=./tmp/downloads

# Minutes a prepared ZIP stays downloadable before it is cleaned up.
DOWNLOAD_TTL_MINUTES=30

# Advanced / optional: override the Cloudinary API host. Leave unset to use
# api.cloudinary.com. Useful for regional endpoints or for a mock in tests.
# CLOUDINARY_API_BASE=https://api.cloudinary.com
